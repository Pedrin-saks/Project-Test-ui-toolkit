.shopping-building-card-host {
    width: 332px;
    min-width: 332px;
    max-width: 332px;
    height: 500px;
    min-height: 500px;
    max-height: 500px;
    flex-shrink: 0;
}

.shopping-building-card {
    width: 332px;
    min-width: 332px;
    max-width: 332px;
    height: 500px;
    min-height: 500px;
    max-height: 500px;
}

.shopping-building-card__frame {
    position: relative;
    width: 100%;
    height: 100%;
    padding-right: 18px;
    padding-bottom: 16px;
    padding-left: 18px;
    flex-direction: column;
    justify-content: space-between;
    background-image: url("project://database/Assets/_Project/art/bg_building2.png?fileID=2800000&guid=a82c1f4dbb8291f4b9bd37281bdf93eb&type=3#bg_building2");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    -unity-background-scale-mode: stretch-to-fill;
}

.shopping-building-card__title-bar {
    min-height: 58px;
    max-height: 72px;
    height: 14%;
    margin-right: -18px;
    margin-left: -18px;
    padding-bottom: 6px;
    align-items: center;
    justify-content: center;
}

.shopping-building-card__title-bar--featured {
    background-image: url("project://database/Assets/_Project/art/barTopItem.png?fileID=2800000&guid=883750c9ca30c6d4797bb8a38efec872&type=3#barTopItem");
    background-repeat: no-repeat;
    background-size: 100% 100%;
    -unity-background-scale-mode: stretch-to-fill;
}

.shopping-building-card__title {
    font-size: 30px;
    -unity-font-style: bold;
    color: var(--shopping-text-dark);
    -unity-text-align: middle-center;
}

.shopping-building-card__title--featured {
    color: var(--shopping-text-light);
}

.shopping-building-card__title--locked {
    color: rgba(139, 120, 86, 0.95);
}

.shopping-building-card__title--featured.shopping-building-card__title--locked {
    color: rgba(214, 196, 152, 0.95);
}

.shopping-building-card__divider {
    height: 2px;
    margin-bottom: 10px;
    background-color: rgba(154, 126, 89, 0.35);
}

.shopping-building-card__bonus-row {
    min-height: 28px;
    max-height: 40px;
    height: 8%;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
}

.shopping-building-card__bonus-icon {
    width: 28px;
    height: 24px;
    margin-right: 8px;
    background-image: url("project://database/Assets/_Project/art/IconMan.png?fileID=2800000&guid=3f46828451ce8e345a59a2773697757f&type=3#IconMan");
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
}

.shopping-building-card__bonus-text {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(150, 97, 61);
    -unity-text-align: middle-left;
}

.shopping-building-card__image {
    flex-grow: 1;
    margin-top: 6px;
    margin-bottom: 12px;
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
}

.shopping-building-card__image--locked {
    opacity: 0.48;
}

.shopping-building-card__footer {
    min-height: 64px;
    max-height: 78px;
    height: 16%;
    justify-content: flex-end;
    position: relative;
}

.shopping-building-card__locked-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    display: none;
    background-color: rgba(231, 219, 183, 0.38);
}

.shopping-purchase-button {
    min-height: 60px;
    max-height: 76px;
    height: 100%;
    padding-left: 18px;
    padding-right: 18px;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    background-color: rgba(255, 255, 255, 0);
    background-image: url("project://database/Assets/_Project/art/Btn_green.png?fileID=2800000&guid=668f04043b936874aa36e592c60ad498&type=3#Btn_green");
    background-repeat: no-repeat;
    background-size: 100% 100%;
}

.shopping-purchase-button__icon {
    width: 34px;
    height: 34px;
    margin-right: 8px;
    background-image: url("project://database/Assets/_Project/art/Icon_hud_Coin.png?fileID=2800000&guid=3cbcea55b2c9381428b32d497ed95d5e&type=3#Icon_hud_Coin");
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
}

.shopping-purchase-button__label {
    font-size: 34px;
    -unity-font-style: bold;
    color: var(--shopping-text-light);
    -unity-text-outline-color: var(--shopping-outline-green);
    -unity-text-outline-width: 4px;
    -unity-font-definition: url("project://database/Assets/_Project/Fonts/Baloo-Regular.ttf?fileID=12800000&guid=df6fae99ef3376f4ba0c6157fc122b52&type=3#Baloo-Regular");
}

.shopping-building-card__locked-state {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    display: none;
    position: relative;
}

.shopping-building-card__locked-icon {
    width: 32px;
    height: 42px;
    margin-right: 10px;
    background-image: url("project://database/Assets/_Project/art/padlock.png?fileID=2800000&guid=d5e8c826b7dd0994aa90c504492680b0&type=3#padlock");
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center;
}

.shopping-building-card__locked-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(121, 79, 56);
    -unity-text-align: middle-left;
}

.shopping-building-card--locked .shopping-building-card__locked-overlay {
    display: flex;
}

.shopping-building-card-host--compact {
    width: 272px;
    min-width: 272px;
    max-width: 272px;
    height: 368px;
    min-height: 368px;
    max-height: 368px;
}

.shopping-building-card--compact {
    width: 272px;
    min-width: 272px;
    max-width: 272px;
    height: 368px;
    min-height: 368px;
    max-height: 368px;
}

.shopping-building-card--compact .shopping-building-card__title {
    font-size: 24px;
}

.shopping-building-card--compact .shopping-building-card__bonus-text {
    font-size: 18px;
}

.shopping-building-card--compact .shopping-purchase-button__label {
    font-size: 26px;
}

.shopping-building-card--compact .shopping-building-card__locked-label {
    font-size: 16px;
}

.shopping-building-card--compact .shopping-building-card__footer {
    min-height: 56px;
    max-height: 68px;
    height: 15%;
}

.shopping-building-card--compact .shopping-purchase-button {
    min-height: 54px;
    max-height: 68px;
}

.shopping-building-card--compact .shopping-purchase-button__icon {
    width: 26px;
    height: 26px;
}
