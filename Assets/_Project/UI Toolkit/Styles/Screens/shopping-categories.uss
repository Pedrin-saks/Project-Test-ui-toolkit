.shopping-categories__panel {
    width: 92%;
    height: 84%;
    min-width: 280px;
    min-height: 320px;
    max-width: 1320px;
    max-height: 820px;
}

.shopping-categories__content {
    flex-grow: 1;
    padding-top: 40px;
    padding-right: 56px;
    padding-bottom: 28px;
    padding-left: 56px;
}

.shopping-categories__scroll {
    flex-grow: 1;
}

.shopping-categories__scroll > .unity-scroll-view__content-container {
    flex-grow: 1;
}

.shopping-categories__scroll .unity-scroll-view__vertical-scroller {
    width: 34px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    background-color: rgba(255, 255, 255, 0);
    align-items: stretch;
    justify-content: flex-start;
}

.shopping-categories__scroll .unity-scroll-view__vertical-scroller .unity-scroller__slider {
    width: 100%;
    flex-grow: 1;
}

.shopping-categories__scroll .unity-scroll-view__vertical-scroller .unity-base-slider__tracker {
    width: 100%;
    height: 100%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    background-image: url("project://database/Assets/_Project/art/background_Scroll.png?fileID=2800000&guid=e40bee6c83000714797b30ce1a1d5a25&type=3#background_Scroll");
    background-repeat: no-repeat;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(255, 255, 255, 0);
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    align-items: center;
}

.shopping-categories__scroll .unity-scroll-view__vertical-scroller .unity-base-slider__dragger {
    min-height: 140px;
    width: 97%;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    background-image: url("project://database/Assets/_Project/art/Bar_Scroll.png?fileID=2800000&guid=37057a0a891dbd74c97ae839b11718d7&type=3#Bar_Scroll");
    background-repeat: no-repeat;
    -unity-background-scale-mode: stretch-to-fill;
    background-color: rgba(255, 255, 255, 0);
    background-size: 100% 100%;
    -unity-slice-left: 20;
    -unity-slice-top: 20;
    -unity-slice-right: 20;
    -unity-slice-bottom: 20;
    align-self: center;
    margin-left: -2px;
}

.shopping-categories__scroll .unity-scroll-view__vertical-scroller .unity-scroller__low-button,
.shopping-categories__scroll .unity-scroll-view__vertical-scroller .unity-scroller__high-button {
    display: none;
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
}

.shopping-categories__grid {
    flex-grow: 1;
    width: 100%;
    max-width: 1080px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-content: flex-start;
    align-items: stretch;
    align-self: center;
    padding-bottom: 8px;
}
